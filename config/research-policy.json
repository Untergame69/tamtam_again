{
  "version": "prospective-pilot-v1",
  "description": "Conservative pilot parameters, not statistically certified universal thresholds. Timed windows bound experiments; adaptive account/market maturity triggers exploration.",
  "network": "hyperliquid-mainnet",
  "max_plans": 4,
  "max_jobs_per_tick": 1,
  "model": "gpt-6.1-sol",
  "timeout_seconds": 120,
  "max_output_tokens": 3000,
  "max_packet_chars": 45000,
  "max_prompt_chars": 65000,
  "call_reservation_usd": "1",
  "freeze_grace_ms": 1800000,
  "embargo_ms": 300000,
  "comparison_ms": 86400000,
  "final_ms": 172800000,
  "sample_window_ms": 3600000,
  "max_cycle_summaries": 12,
  "max_sample_events": 100,
  "criteria": {
    "block_ms": 3600000,
    "min_blocks": 12,
    "min_regimes": 2,
    "max_positive_block_share": "0.3",
    "min_net_pnl": "0",
    "max_drawdown_usdc": "10",
    "min_block_lower_bound": "0",
    "stress_multiplier": "2",
    "min_stress_net_pnl": "0",
    "require_funding": true,
    "dependence_justification": "Hourly blocks exceed permitted 2-minute holding/lookback horizon. Serial dependence is not proven absent; normal interval is descriptive. Concentration, multiple regimes and stressed costs are additional gates; revise prospectively if dependence diagnostics contradict this pilot assumption.",
    "regime_threshold_bps": "10",
    "regime_window_ms": 600000,
    "confidence_alpha": "0.05"
  },
  "budget": {
    "max_runs": 8,
    "max_same_input_corrections": 1,
    "max_duration_ms": 604800000,
    "max_cost_usd": "2"
  },
  "strategy_template": {
    "schema_version": 2,
    "type": "follower",
    "market": "REPLACED_BY_PAIR",
    "data_sources": ["bbo", "userFills", "streamHealth", "userFundings"],
    "signal": {"kind": "leader_delta"},
    "entry": {"kind": "target_position"},
    "exit": {"kind": "horizon_or_target"},
    "sizing": {"scale": "0.001"},
    "max_exposure": {"notional_usdc": "100", "max_drawdown_usdc": "10", "max_leverage": "1"},
    "fees": {"maker_bps": "4.5", "taker_bps": "4.5"},
    "slippage": {"bps": "5"},
    "latency_ms": 5000,
    "horizon_ms": 120000,
    "starting_capital_usdc": "1000",
    "execution": {"kind": "market_ioc", "heartbeat_timeout_ms": 65000, "unknown_quote_max_age_ms": 1000, "order_ttl_ms": 10000, "displayed_size_fraction": "0.1"},
    "invalidation_conditions": ["nonpositive edge after costs", "unknown or interrupted feed", "risk limit reached", "insufficient independent market episodes"]
  }
}
