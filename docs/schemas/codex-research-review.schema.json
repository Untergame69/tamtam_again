{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "input_fingerprint",
    "decision",
    "next_required_cycles",
    "findings",
    "reason"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "run_id": { "type": "string" },
    "input_fingerprint": { "type": "string", "minLength": 32 },
    "decision": {
      "type": "string",
      "enum": ["approve", "needs_more_data", "redo_re", "reject"]
    },
    "next_required_cycles": { "type": "integer", "minimum": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "assessment", "evidence"],
        "properties": {
          "claim": { "type": "string" },
          "assessment": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
