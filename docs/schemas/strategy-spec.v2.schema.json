{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executable strategy specification v2",
  "description": "Structural schema. engine.validate_spec also enforces supported rules, numerical and causal constraints.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "market",
    "data_sources",
    "signal",
    "entry",
    "exit",
    "sizing",
    "max_exposure",
    "fees",
    "slippage",
    "latency_ms",
    "horizon_ms",
    "starting_capital_usdc",
    "execution",
    "invalidation_conditions"
  ],
  "properties": {
    "signal": {
      "type": "object"
    },
    "entry": {
      "type": "object"
    },
    "exit": {
      "type": "object"
    },
    "sizing": {
      "type": "object"
    },
    "max_exposure": {
      "type": "object"
    },
    "fees": {
      "type": "object"
    },
    "slippage": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "schema_version": {
      "const": 2
    },
    "type": {
      "enum": [
        "follower",
        "autonomous"
      ]
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "horizon_ms": {
      "type": "integer",
      "minimum": 1
    },
    "starting_capital_usdc": {
      "type": [
        "string",
        "number"
      ]
    },
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
